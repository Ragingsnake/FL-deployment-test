# FL Server / Aggregator container
FROM python:3.10-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl && \
    rm -rf /var/lib/apt/lists/* && \
    python -m venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

COPY fl_server.py model.py blockchain.py reputation.py ipfs_utils.py utils.py zkp_utils.py comparison.py comparison_1.py plot_results.py ./
COPY FL_Server ./FL_Server
COPY build/contracts/ ./build/contracts

FROM python:3.10-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH=/opt/venv/bin:$PATH \
    FL_SERVER_ADDRESS=0.0.0.0:8080 \
    IPFS_API=/dns/ipfs-svc.ipfs.svc.cluster.local/tcp/5001 \
    ETH_RPC=http://geth-svc.blockchain.svc.cluster.local:8545 \
    CONTRACT_ADDRESS_FILE=/app/build/contracts/Reputation.address

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/fl_server.py /app/model.py /app/blockchain.py /app/reputation.py /app/ipfs_utils.py /app/utils.py /app/zkp_utils.py /app/comparison.py /app/comparison_1.py /app/plot_results.py /app/
COPY --from=builder /app/FL_Server /app/FL_Server
COPY --from=builder /app/build/contracts/ /app/build/contracts

EXPOSE 8080

CMD ["python", "fl_server.py"]

