# Ethereum PoA (Clique) single-node + Truffle migration runner
# Baseline is the previously working single-stage image, with only conservative size trims.
FROM node:18-bullseye-slim

WORKDIR /chain

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates jq && \
        curl -L https://gethstore.blob.core.windows.net/builds/geth-linux-amd64-1.13.15-c5ba367e.tar.gz \
            | tar -xz --strip-components=1 -C /usr/local/bin geth-linux-amd64-1.13.15-c5ba367e/geth && \
        curl -L https://dl.k8s.io/release/v1.34.6/bin/linux/amd64/kubectl -o /usr/local/bin/kubectl && \
        chmod +x /usr/local/bin/kubectl && \
        rm -rf /var/lib/apt/lists/*

RUN npm install -g truffle@5.11.5 && \
    rm -rf /var/lib/apt/lists/*

# Copy only files needed for contract migration to keep image smaller than COPY . /chain.
COPY package.json package-lock.json* ./
RUN npm install --omit=dev || npm install || true
COPY contracts ./contracts
COPY migrations ./migrations
COPY truffle-config.js ./

COPY deployment/docker/geth-entrypoint.sh /usr/local/bin/geth-entrypoint.sh
RUN chmod +x /usr/local/bin/geth-entrypoint.sh && truffle version >/dev/null

EXPOSE 8545 8546 30303

ENTRYPOINT ["/usr/local/bin/geth-entrypoint.sh"]
