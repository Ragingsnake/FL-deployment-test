# Ethereum PoA (Clique) single-node + Truffle migration runner
FROM node:18-bullseye

WORKDIR /chain

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates jq && \
    curl -L https://gethstore.blob.core.windows.net/builds/geth-linux-arm64-1.13.15-c5ba367e.tar.gz \
      | tar -xz --strip-components=1 -C /usr/local/bin geth-linux-arm64-1.13.15-c5ba367e/geth && \
    npm install -g truffle@5.11.5 && \
    rm -rf /var/lib/apt/lists/*
# Project files (contracts, migrations, truffle-config.js)
COPY . /chain

RUN npm install || true

COPY deployment/docker/geth-entrypoint.sh /usr/local/bin/geth-entrypoint.sh
RUN chmod +x /usr/local/bin/geth-entrypoint.sh

EXPOSE 8545 8546 30303

ENTRYPOINT ["/usr/local/bin/geth-entrypoint.sh"]
